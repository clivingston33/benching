# Copy to config/<provider>.env and chmod 600, then fill in the values.
# <PROVIDER> is the provider name from config/benchmark.yaml, uppercased with
# dashes replaced by underscores (e.g. provider "my-provider" -> MY_PROVIDER).
# Tokenizer override is optional and shared; see benchmark.yaml tokenizer.
<PROVIDER>_API_KEY=
<PROVIDER>_BASE_URL=https://api.example.com/v1
TOKENIZER_PATH=

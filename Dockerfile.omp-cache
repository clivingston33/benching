# Builds a scratch image containing the pinned omp binary at /omp-<version>.
# Extract the binary into cache/omp-<version> to serve Harbor tasks:
ARG OMP_VERSION=17.1.3

FROM debian:bookworm-slim AS build
ARG OMP_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL -o /omp "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/omp-linux-x64" \
    && chmod 755 /omp

FROM scratch
ARG OMP_VERSION
COPY --from=build /omp /omp-${OMP_VERSION}
